output "cluster_name" {
  description = "Generated cluster name."
  value       = random_pet.cluster.id
}

output "release_id" {
  description = "Identifier of the current release."
  value       = random_id.release.hex
}

output "service_names" {
  description = "Names generated by the naming module."
  value = {
    api    = module.api_name.name
    worker = module.worker_name.name
  }
}

output "certificate_expires_at" {
  description = "When the platform certificate expires."
  value       = tls_self_signed_cert.platform.validity_end_time
}

output "signing_rotates_at" {
  description = "When the signing material next rotates."
  value       = time_rotating.signing.rotation_rfc3339
}

output "upstream_status" {
  description = "HTTP status returned by the upstream health check."
  value       = data.http.upstream.status_code
}
